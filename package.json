{
  "name": "javascript-project-scripts",
  "version": "9.0.0",
  "description": "Common Scripts and setup files across projects",
  "main": "./index.js",
  "scripts": {
    "build:types": "tsc",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "publish:patch": "npm version patch",
    "publish:minor": "npm version minor",
    "publish:major": "npm version major"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "javascript-project-scripts": "./bin/javascript-project-scripts.js"
  },
  "files": [
    "lib/tsconfig.json",
    "eslint.config.mjs",
    "prettierrc.js",
    "commands/",
    "lib/"
  ],
  "exports": {
    "./tsconfig.node.json": "./lib/tsconfig.node.json",
    "./tsconfig.web.json": "./lib/tsconfig.web.json",
    "./prettierrc.js": "./lib/prettierrc.js",
    "./build": {
      "types": "./lib/build/index.d.mts",
      "import": "./lib/build/index.mjs"
    },
    "./eslint-config": "./eslint.config.mjs"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-less": "1.3.39",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "which": "3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archer56/project-scripts.git"
  },
  "author": "Ben Archer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/archer56/project-scripts/issues"
  },
  "homepage": "https://github.com/archer56/project-scripts#readme",
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
